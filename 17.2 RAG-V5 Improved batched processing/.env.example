# ============================================================
# Legal RAG Pipeline V5 - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# All values are read by the pipeline - NO hard-coded paths!

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legalrag_v5_db
DB_USER=quest  # Run: echo $USER to get your macOS username
DB_PASSWORD=quest  # Optional, leave empty for local development

# Connection pool settings
DB_POOL_MIN=1
DB_POOL_MAX=10

# Transaction retry settings
DB_MAX_RETRIES=3
DB_RETRY_DELAY_MS=1000

# ============================================================
# DIRECTORY CONFIGURATION
# ============================================================
# All paths should be absolute or relative to workspace root
# Use forward slashes (/) for cross-platform compatibility
# Reusing existing pipeline_storage structure for consistency

# Source directory for documents to be chunked (folder-driven)
# Documents placed here will be picked up for processing
SOURCE_DIR=./rag-dataset/legal documents

# General storage for pipeline artifacts (existing structure)
STORAGE_DIR=./pipeline_storage

# Output directory for final processed files
OUTPUT_DIR=./pipeline_storage/results

# Batch files directory (JSONL chunks + pickle embeddings)
# New subdirectory under pipeline_storage
BATCH_FILE_DIR=./pipeline_storage/batches

# Temporary OCR working directory (reuse existing)
OCR_TMP_DIR=./pipeline_storage/ocr_output

# Log directory for all pipeline logs
LOG_DIR=./logs

# Audit log specifically for OCR corrections
AUDIT_CORRECTIONS_FILE=./logs/ocr_corrections.log

# ============================================================
# BATCH PROCESSING CONFIGURATION
# ============================================================
# Number of records per database insert batch
BATCH_SIZE=500

# Number of parallel batch writers (optional, default: 1)
BATCH_WRITE_PARALLEL=1

# ============================================================
# OCR & NLP CONFIGURATION
# ============================================================
# LegalBERT model for grammar corrections during OCR
LEGALBERT_MODEL=nlpaueb/legal-bert-base-uncased

# Confidence threshold for automatic OCR corrections (0.0-1.0)
LEGALBERT_CONFIDENCE_THRESHOLD=0.8

# OCR audit mode: log corrections without applying them
OCR_AUDIT_ONLY=false

# EasyOCR settings
OCR_ENGINE=EasyOCR
OCR_LANG=en
OCR_CONFIDENCE_THRESHOLD=0.6

# ============================================================
# EMBEDDING CONFIGURATION
# ============================================================
# Ollama embedding model settings
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIM=768

# ============================================================
# CHUNKING CONFIGURATION
# ============================================================
# Token limits for chunking
MIN_CHUNK_TOKENS=400
MAX_CHUNK_TOKENS=800
CHUNK_OVERLAP_PERCENTAGE=0.15

# Semantic chunking threshold (0.0-1.0)
SEMANTIC_SIMILARITY_THRESHOLD=0.8

# ============================================================
# DOCUMENT CLASSIFICATION
# ============================================================
DIGITAL_TEXT_THRESHOLD=50
SCANNED_CONFIDENCE_THRESHOLD=0.5

# ============================================================
# LEGAL DOCUMENT METADATA
# ============================================================
DEFAULT_JURISDICTION=Kenya
ALLOWED_DOC_TYPES=Constitution,Act,Regulation,Notice,Corrigendum,Guideline

# ============================================================
# VERSIONING & DEDUPLICATION
# ============================================================
SHINGLE_SIZE=5
SIMILARITY_THRESHOLD=0.95

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
STRUCTURED_LOGGING=true

# ============================================================
# ENVIRONMENT & MODE
# ============================================================
ENV=development
MODE=batch
USE_GPU=true

# ============================================================
# SAFETY & VALIDATION
# ============================================================
STOP_ON_ERROR=true
VALIDATE_BATCH_FILES=true
ARCHIVE_SOURCE_FILES=true
ARCHIVE_DIR=./data/archive

# ============================================================
# PERFORMANCE TUNING
# ============================================================
WORKER_THREADS=4
MAX_BATCH_MEMORY_MB=512
COMPRESS_BATCH_FILES=false

# ============================================================
# DEVELOPMENT & DEBUGGING
# ============================================================
DEBUG_MODE=false
SAMPLE_SIZE=0
SKIP_STEPS=
